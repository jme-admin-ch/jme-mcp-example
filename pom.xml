<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <url>https://github.com/jme-admin-ch/jme-mcp-example/tree/main</url>
    <scm>
        <url>https://github.com/jme-admin-ch/jme-mcp-example.git</url>
        <connection>scm:git:git://github.com/jme-admin-ch/jme-mcp-example.git</connection>
        <developerConnection>scm:git:ssh://github.com:jme-admin-ch/jme-mcp-example.git</developerConnection>
    </scm>
    <developers>
        <developer>
            <name>BIT</name>
            <email>jeap-community@bit.admin.ch</email>
            <organization>Federal Office of Information Technology, Systems and Telecommunication FOITT</organization>
            <organizationUrl>https://www.bit.admin.ch/</organizationUrl>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <parent>
        <groupId>ch.admin.bit.jeap</groupId>
        <artifactId>jeap-spring-boot-parent</artifactId>
        <version>41.37.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <artifactId>jme-mcp-example</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <version>1.4.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <description>
        jEAP example showing the jeap-spring-boot-mcp-starter: one service exposing authenticated MCP tools
        (backed by a local jeap-oauth-mock-server instance) and one with jeap.mcp.security.anonymous-access
        enabled for public tools.
    </description>

    <modules>
        <module>jme-mcp-oauth-mock</module>
        <module>jme-mcp-authenticated-service</module>
        <module>jme-mcp-anonymous-service</module>
        <module>jme-mcp-test</module>
    </modules>

    <properties>
        <!-- Example application modules only, nothing published as a library -->
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <jeap-oauth-mock-server.version>11.17.0</jeap-oauth-mock-server.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Add license to jar manifest -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <configuration>
                        <archive>
                            <manifestEntries>
                                <Bundle-License>https://www.apache.org/licenses/LICENSE-2.0</Bundle-License>
                            </manifestEntries>
                        </archive>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Check third-party license compliance -->
            <plugin>
                <groupId>org.honton.chas</groupId>
                <artifactId>license-maven-plugin</artifactId>
            </plugin>
            <!-- Generate third-party license list and check for missing license information -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
